<?xml version="1.0" encoding="UTF-8" ?>
<ruleset
  name="Pricing Department Apex rules"
  xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 https://pmd.sourceforge.io/ruleset_2_0_0.xsd"
>
    <description
  >Apex quickstart rules. CI fails on priority 3 (all quickstart rules).</description>
    <rule ref="rulesets/apex/quickstart.xml">
        <!-- Test classes deliberately create many records inline. -->
        <exclude name="ApexUnitTestClassShouldHaveRunAs" />
        <!-- intent is documented in prose block comments, not @description tags -->
        <exclude name="ApexDoc" />
        <!-- phase 2 replaces the 9-argument search signature with one request object; remove this exclusion then -->
        <exclude name="ExcessiveParameterList" />
    </rule>
</ruleset>
